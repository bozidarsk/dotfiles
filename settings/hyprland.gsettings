org.nemo.icon-view labels-beside-icons false
org.nemo.icon-view text-ellipsis-limit ['3']
org.nemo.icon-view thumbnail-size 64
org.nemo.list-view default-column-order ['name', 'size', 'date_modified', 'type', 'date_created_with_time', 'date_accessed', 'date_created', 'detailed_type', 'group', 'where', 'mime_type', 'date_modified_with_time', 'octal_permissions', 'owner', 'permissions']
org.nemo.list-view default-visible-columns ['name', 'size', 'date_modified', 'mime_type', 'permissions']
